{
  "name": "ai-usage-dashboard",
  "productName": "AI Usage Dashboard",
  "version": "0.1.8",
  "description": "Claude / ChatGPT / Cursor / Gemini / Perplexity / Grok 및 Copilot·영상 AI 등 사용량을 한 화면에서 보여주는 데스크톱 앱",
  "main": "src/main.js",
  "author": "poohc",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.poohc.ai-usage-dashboard",
    "productName": "AI Usage Dashboard",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
